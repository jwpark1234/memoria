{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memoria",
  "version": "0.1.8",
  "identifier": "com.jwpark.memoria",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Memoria",
        "width": 400,
        "height": 600,
        "minWidth": 260,
        "minHeight": 220,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "transparent": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxNDJDRDY4RDU2MEQ1REEKUldUYTFXRFZhTTFDUVdKSTIyQ3NIL3ZIejJsOEJZWThFQzVxZ0RJM0dWK0NIdlB5RmZxcUI0WDQK",
      "endpoints": [
        "https://github.com/jwpark1234/memoria/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
