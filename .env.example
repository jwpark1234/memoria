# Firebase 콘솔 → 프로젝트 설정 → 내 앱(웹 앱)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Google Cloud 콘솔 → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID (유형: 데스크톱 앱)
# 같은 GCP 프로젝트(= Firebase 프로젝트)에서 만들어야 Firebase가 토큰을 받아준다.
# 데스크톱 앱용 secret은 구글 정책상 비밀로 취급되지 않는다(앱에 포함되는 값).
VITE_GOOGLE_DESKTOP_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=
